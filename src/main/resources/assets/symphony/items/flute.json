{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "model": {
          "type": "minecraft:model",
          "model": "symphony:item/flute_2d"
        },
        "when": [
          "gui",
          "ground",
          "fixed"
        ]
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "symphony:flute_playing",
      "cases": [
        {
          "when": true,
          "model": {
            "type": "minecraft:model",
            "model": "symphony:item/flute_playing"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "symphony:item/flute"
      }
    }
  }
}